# ── Application ──────────────────────────────────────────────────────────
SERVICE_NAME=pinpad
API_PORT=5000
DEV_MODE=true
LOG_LEVEL=INFO
ROLE=api
ALLOWED_ORIGINS=*

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://pinpad:pinpad@localhost:5432/pinpad
POSTGRES_USER=pinpad
POSTGRES_PASSWORD=pinpad
POSTGRES_DB=pinpad
POSTGRES_PORT=5432

# ── Access codes ───────────────────────────────────────────────────────────
PIN_LENGTH=4
PERSON_CODE_LENGTH=4
DOOR_UNLOCK_SECONDS=5

# ── Frontend (docker) ──────────────────────────────────────────────────────
FRONTEND_PORT=3000
